# Names only. deploy/gcp/gen-env.sh writes the real deploy/gcp/.env.prod
# (mode 600, gitignored) with random values. Never commit values.

# Public hostnames nginx serves (TLS terminated there).
MNEMOS_WEB_HOST=
MNEMOS_API_HOST=
MNEMOS_WS_HOST=
MNEMOS_AUTH_HOST=

# Data tier. POSTGRES_PASSWORD and the MinIO root pair are fixed into their
# volumes on first start; changing them later needs a manual rotation.
POSTGRES_PASSWORD=
MNEMOS_APP_DATABASE_PASSWORD=
MNEMOS_RO_DATABASE_PASSWORD=
KEYCLOAK_DB_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Application secrets. JWT secret >= 32 bytes; three distinct Fernet keys.
MNEMOS_JWT_SECRET=
MNEMOS_DSN_ENCRYPTION_KEY=
MNEMOS_SOURCE_ENCRYPTION_KEY=
MNEMOS_TOOL_ENCRYPTION_KEY=

# Keycloak master-realm admin (first start only) and `mnemosctl bootstrap`'s
# internal admin.
KEYCLOAK_ADMIN_PASSWORD=
MNEMOS_BOOTSTRAP_ADMIN_PASSWORD=

# Passwords for the three seeded realm users (admin@/analyst@/user@mnemos.local),
# read by render-realm.py. Applied only on the realm's first import.
MNEMOS_DEMO_ADMIN_PASSWORD=
MNEMOS_DEMO_ANALYST_PASSWORD=
MNEMOS_DEMO_USER_PASSWORD=
