.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
secrets/
.secrets/

# ---- Local runtime state ----
.data/
volumes/
*.db
*.sqlite3
logs/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ---- Personal documents (must never enter this repo) ----
*.pdf
*resume*
*Resume*
