# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/

# ---- Node / frontend ----
node_modules/
.next/
out/
*.tsbuildinfo
.turbo/

# ---- Secrets & local config ----
# Never commit real secrets. Only *.example files are tracked.
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
secrets/
.secrets/

# ---- Local runtime state ----
.data/
volumes/
*.db
*.sqlite3
logs/
*.log

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# ---- Personal documents (must never enter this repo) ----
# Scoped to the repository root so a legitimate test-corpus PDF under
# tests/fixtures/ is not silently excluded.
/*.pdf
/*resume*
/*Resume*

# Local venv and runtime data
.venv/
.data/

# Production deployment state — secrets and the realm rendered from them.
# Never committed; they live only on the deployment VM (docs/Deploy.md).
/deploy/gcp/.env.prod
/deploy/gcp/keycloak/
